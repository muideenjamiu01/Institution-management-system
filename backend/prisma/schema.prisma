generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GradeValue {
  A
  B
  C
  D
  E
  F
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  students    Student[]
  courses     Course[]

  @@index([code])
  @@map("departments")
}

model Applicant {
  id                Int                  @id @default(autoincrement())
  firstName         String
  lastName          String
  email             String               @unique
  phone             String
  dateOfBirth       DateTime
  gender            Gender
  address           String               @db.Text
  previousSchool    String
  gradeAverage      Float
  applicationDate   DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  admissionDecision AdmissionDecision?
  matricNumber      MatricNumber?

  @@index([email])
  @@index([applicationDate])
  @@map("applicants")
}

model AdmissionDecision {
  id             Int               @id @default(autoincrement())
  applicantId    Int               @unique
  status         ApplicationStatus @default(PENDING)
  decisionDate   DateTime?
  decisionReason String?           @db.Text
  decidedBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  applicant      Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("admission_decisions")
}

model MatricNumber {
  id          Int       @id @default(autoincrement())
  applicantId Int       @unique
  matricNo    String    @unique
  generatedAt DateTime  @default(now())
  studentId   Int?      @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [studentId], references: [id])

  @@index([matricNo])
  @@map("matric_numbers")
}

model Student {
  id                   Int                   @id @default(autoincrement())
  matricNo             String                @unique
  firstName            String
  lastName             String
  email                String                @unique
  phone                String
  dateOfBirth          DateTime
  gender               Gender
  address              String                @db.Text
  departmentId         Int
  enrollmentDate       DateTime              @default(now())
  currentLevel         Int                   @default(100)
  status               String                @default("ACTIVE")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  department           Department            @relation(fields: [departmentId], references: [id])
  courseRegistrations  CourseRegistration[]
  scores               Score[]
  matricNumberRelation MatricNumber?

  @@index([matricNo])
  @@index([email])
  @@index([departmentId])
  @@map("students")
}

model Course {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique
  title               String
  description         String?               @db.Text
  credits             Int
  departmentId        Int
  level               Int
  semester            Int
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  department          Department            @relation(fields: [departmentId], references: [id])
  courseRegistrations CourseRegistration[]
  exams               Exam[]

  @@index([code])
  @@index([departmentId])
  @@map("courses")
}

model CourseRegistration {
  id              Int      @id @default(autoincrement())
  studentId       Int
  courseId        Int
  registrationDate DateTime @default(now())
  academicYear    String
  semester        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, academicYear, semester])
  @@index([studentId])
  @@index([courseId])
  @@map("course_registrations")
}

model Exam {
  id          Int      @id @default(autoincrement())
  courseId    Int
  title       String
  description String?  @db.Text
  examDate    DateTime
  maxScore    Float    @default(100)
  academicYear String
  semester    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scores      Score[]

  @@index([courseId])
  @@index([examDate])
  @@map("exams")
}

model Score {
  id        Int        @id @default(autoincrement())
  examId    Int
  studentId Int
  score     Float
  grade     GradeValue
  remarks   String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([grade])
  @@map("scores")
}
