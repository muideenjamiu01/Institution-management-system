generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GradeValue {
  A
  B
  C
  D
  E
  F
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PAYSTACK
  FLUTTERWAVE
  WALLET
  CASH
}

enum InvoiceType {
  SCHOOL_FEE
  DEPARTMENTAL_FEE
  TECHNOLOGY_FEE
  EXAMINATION_FEE
  DEVELOPMENT_FEE
  ACCREDITATION_FEE
  ACCEPTANCE_FEE
  OTHER
}

enum SemesterType {
  FIRST
  SECOND
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

enum ProgramType {
  ND          // National Diploma
  HND         // Higher National Diploma
  BSC         // Bachelor of Science
  MSC         // Master of Science
  PHD         // Doctor of Philosophy
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model Department {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  code        String       @unique
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  students    Student[]
  courses     Course[]
  programs    Program[]
  applicants  Applicant[]

  @@index([code])
  @@map("departments")
}

model Applicant {
  id                Int                  @id @default(autoincrement())
  username          String               @unique
  firstName         String
  lastName          String
  email             String               @unique
  phone             String
  password          String?
  dateOfBirth       DateTime?
  gender            Gender?
  address           String?              @db.Text
  previousSchool    String?
  gradeAverage      Float?
  programType       ProgramType?         // BSC, MSC, PHD
  departmentId      Int?
  programId         Int?
  applicationDate   DateTime             @default(now())
  refreshToken      String?              @db.Text
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  admissionDecision AdmissionDecision?
  matricNumber      MatricNumber?
  department        Department?          @relation(fields: [departmentId], references: [id])
  program           Program?             @relation(fields: [programId], references: [id])

  @@index([email])
  @@index([username])
  @@index([applicationDate])
  @@index([departmentId])
  @@index([programId])
  @@map("applicants")
}

model AdmissionDecision {
  id             Int               @id @default(autoincrement())
  applicantId    Int               @unique
  status         ApplicationStatus @default(PENDING)
  decisionDate   DateTime?
  decisionReason String?           @db.Text
  decidedBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  applicant      Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("admission_decisions")
}

model MatricNumber {
  id          Int       @id @default(autoincrement())
  applicantId Int       @unique
  matricNo    String    @unique
  generatedAt DateTime  @default(now())
  studentId   Int?      @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [studentId], references: [id])

  @@index([matricNo])
  @@map("matric_numbers")
}

model Student {
  id                   Int                   @id @default(autoincrement())
  username             String                @unique
  matricNo             String                @unique
  firstName            String
  lastName             String
  email                String                @unique
  password             String?
  phone                String
  dateOfBirth          DateTime
  gender               Gender
  address              String                @db.Text
  departmentId         Int
  programId            Int?
  enrollmentDate       DateTime              @default(now())
  currentLevel         Int                   @default(100)
  currentSessionId     Int?
  status               StudentStatus         @default(ACTIVE)
  profilePicture       String?
  walletBalance        Float                 @default(0)
  acceptanceFeePaid    Boolean               @default(false)
  refreshToken         String?               @db.Text
  resetToken           String?
  resetTokenExpiry     DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  department           Department            @relation(fields: [departmentId], references: [id])
  program              Program?              @relation(fields: [programId], references: [id])
  currentSession       Session?              @relation(fields: [currentSessionId], references: [id])
  courseRegistrations  CourseRegistration[]
  scores               Score[]
  matricNumberRelation MatricNumber?
  invoices             Invoice[]
  payments             Payment[]
  assignmentSubmissions AssignmentSubmission[]
  results              Result[]
  notifications        Notification[]

  @@index([matricNo])
  @@index([username])
  @@index([email])
  @@index([departmentId])
  @@index([programId])
  @@index([currentSessionId])
  @@map("students")
}

model Course {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique
  title               String
  description         String?               @db.Text
  credits             Int
  departmentId        Int
  level               Int
  semester            Int
  prerequisite        String?               // course codes required before registration
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  department          Department            @relation(fields: [departmentId], references: [id])
  courseRegistrations CourseRegistration[]
  exams               Exam[]
  assignments         Assignment[]
  results             Result[]

  @@index([code])
  @@index([departmentId])
  @@map("courses")
}

model CourseRegistration {
  id               Int       @id @default(autoincrement())
  studentId        Int
  courseId         Int
  semesterId       Int?
  registrationDate DateTime  @default(now())
  academicYear     String
  semester         Int
  isCarryOver      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterRecord   Semester? @relation(fields: [semesterId], references: [id])

  @@unique([studentId, courseId, academicYear, semester])
  @@index([studentId])
  @@index([courseId])
  @@index([semesterId])
  @@map("course_registrations")
}

model Exam {
  id          Int      @id @default(autoincrement())
  courseId    Int
  title       String
  description String?  @db.Text
  examDate    DateTime
  maxScore    Float    @default(100)
  academicYear String
  semester    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scores      Score[]

  @@index([courseId])
  @@index([examDate])
  @@map("exams")
}

model Score {
  id        Int        @id @default(autoincrement())
  examId    Int
  studentId Int
  score     Float
  grade     GradeValue
  remarks   String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([grade])
  @@map("scores")
}

// New models for Student Portal

model Program {
  id           Int          @id @default(autoincrement())
  name         String
  code         String       @unique
  departmentId Int
  duration     Int          // in years
  description  String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  department   Department   @relation(fields: [departmentId], references: [id])
  students     Student[]
  applicants   Applicant[]

  @@index([code])
  @@index([departmentId])
  @@map("programs")
}

model Session {
  id          Int        @id @default(autoincrement())
  name        String     @unique // e.g., "2025/2026"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  semesters   Semester[]
  students    Student[]
  invoices    Invoice[]
  assignments Assignment[]
  results     Result[]

  @@index([isActive])
  @@map("sessions")
}

model Semester {
  id                  Int                   @id @default(autoincrement())
  sessionId           Int
  type                SemesterType
  startDate           DateTime
  endDate             DateTime
  isActive            Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  session             Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseRegistrations CourseRegistration[]
  invoices            Invoice[]
  assignments         Assignment[]

  @@unique([sessionId, type])
  @@index([sessionId])
  @@index([isActive])
  @@map("semesters")
}

model Invoice {
  id             Int         @id @default(autoincrement())
  invoiceNo      String      @unique
  studentId      Int
  sessionId      Int
  semesterId     Int?
  type           InvoiceType
  description    String?
  amount         Float
  amountPaid     Float       @default(0)
  balance        Float
  level          Int
  status         PaymentStatus @default(PENDING)
  dueDate        DateTime?
  cardPayment    Boolean     @default(true)
  walletPayment  Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session        Session     @relation(fields: [sessionId], references: [id])
  semester       Semester?   @relation(fields: [semesterId], references: [id])
  payments       Payment[]

  @@index([invoiceNo])
  @@index([studentId])
  @@index([sessionId])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id              Int           @id @default(autoincrement())
  studentId       Int
  invoiceId       Int
  amount          Float
  method          PaymentMethod
  reference       String        @unique
  status          PaymentStatus @default(PENDING)
  gatewayResponse String?       @db.Text
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([reference])
  @@index([studentId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

model Assignment {
  id          Int                    @id @default(autoincrement())
  courseId    Int
  sessionId   Int
  semesterId  Int
  title       String
  description String                 @db.Text
  dueDate     DateTime
  maxScore    Float                  @default(100)
  fileUrl     String?
  createdBy   String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session     Session                @relation(fields: [sessionId], references: [id])
  semester    Semester               @relation(fields: [semesterId], references: [id])
  submissions AssignmentSubmission[]

  @@index([courseId])
  @@index([sessionId])
  @@index([dueDate])
  @@map("assignments")
}

model AssignmentSubmission {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  fileUrl      String
  remarks      String?          @db.Text
  score        Float?
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?
  gradedBy     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

model Result {
  id        Int        @id @default(autoincrement())
  studentId Int
  courseId  Int
  sessionId Int
  semester  Int
  score     Float
  grade     GradeValue
  gradePoint Float
  remarks   String?    @db.Text
  isCarryOver Boolean  @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session   Session    @relation(fields: [sessionId], references: [id])

  @@unique([studentId, courseId, sessionId, semester])
  @@index([studentId])
  @@index([courseId])
  @@index([sessionId])
  @@index([grade])
  @@map("results")
}

model Notification {
  id        Int      @id @default(autoincrement())
  studentId Int
  title     String
  message   String   @db.Text
  type      String   // INFO, WARNING, SUCCESS, ERROR
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
